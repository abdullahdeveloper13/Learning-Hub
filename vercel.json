{
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/skillforge-ai run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!media|resources|api|assets|images|favicon\\.svg|robots\\.txt).*)",
      "destination": "/index.html"
    }
  ]
}