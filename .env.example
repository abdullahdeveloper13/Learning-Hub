PORT=3000
BASE_PATH=/
VITE_API_URL=http://localhost:3000
PUBLIC_APP_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:3000
JWT_SECRET=change-me
DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-1-<region>.pooler.supabase.com:5432/postgres
SUPABASE_URL=your-supabase-url
SUPABASE_ANON_KEY=your-public-anon-key
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=course-assets
# AI providers: add any ONE free key below. The server auto-detects them in this order:
# Gemini (free tier, ~1500 req/day) > Groq (free tier) > OpenRouter (:free models) > Mistral (free mode) > OpenAI (paid)
# Set AI_PROVIDER to a specific name (gemini|groq|openrouter|mistral|openai) to force one provider.
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
PAYMENT_PROVIDER=manual
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
EMAIL_PROVIDER=console
EMAIL_FROM=SkillForge AI <noreply@example.com>
RESEND_API_KEY=
RATE_LIMIT_STORE=memory
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
